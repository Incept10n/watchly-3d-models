// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum PartType {
  CASE
  MOVEMENT
  DIAL
  BEZEL
  HANDS
  ROTOR
  CRYSTAL
}

model Part {
  id          Int      @id @default(autoincrement())
  name        String
  type        PartType
  description String
  cost        Decimal  @db.Decimal(10, 2)
  modelUrl    String
  pictureUrl  String   @default("")
  itemUrl     String

  compatibilitiesAsPart1 PartCompatibility[] @relation("Part1")
  compatibilitiesAsPart2 PartCompatibility[] @relation("Part2")
  orderItems            OrderItem[]
}

model PartCompatibility {
  part1Id Int
  part2Id Int

  part1 Part @relation("Part1", fields: [part1Id], references: [id], onDelete: Cascade)
  part2 Part @relation("Part2", fields: [part2Id], references: [id], onDelete: Cascade)

  @@id([part1Id, part2Id])
}

model Order {
  id        Int      @id @default(autoincrement())
  uid       String   @unique @default(uuid())
  createdAt DateTime @default(now())

  items OrderItem[]
}

model OrderItem {
  id      Int  @id @default(autoincrement())
  orderId Int
  partId  Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  part  Part  @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@unique([orderId, partId])
}
